# syntax=docker/dockerfile:1
# Zero-secret isolated code-check runner for Google Cloud Run (Always Free tier).
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV IMPRINT_RUNNER_BIND=0.0.0.0

COPY lib/assessment/developer-bank.ts ./lib/assessment/developer-bank.ts
COPY lib/assessment/code-check-script.ts ./lib/assessment/code-check-script.ts
COPY scripts/cloud-run-runner.mjs ./scripts/cloud-run-runner.mjs

USER 65534:65534
EXPOSE 8080
CMD ["node", "--experimental-strip-types", "scripts/cloud-run-runner.mjs"]
