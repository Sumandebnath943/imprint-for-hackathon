# =============================================================================
# Imprint (Hackathon / Google Cloud Run) — Local Environment Template
# =============================================================================
# 1. Duplicate this file as `.env.local` and paste your values from Vercel.
# 2. `.env.local` is in both `.gitignore` and `.dockerignore` — secrets stay
#    local and are never committed to GitHub or baked into Docker images.
# 3. During Cloud Run deployment, only `NEXT_PUBLIC_*` values are passed as
#    build args; all server secrets are attached only at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED — Supabase (can safely share your existing Supabase project)
# -----------------------------------------------------------------------------
# Public (safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 2. AI FEATURES — Google AI (Vertex AI + Gemma 4 + AI Studio Free Tier)
# -----------------------------------------------------------------------------
# Set to true to enable AI assessment scoring and new Mirror sessions.
IMPRINT_AI_ENABLED=true
# Tier 1 (Primary on Cloud Run — uses GCP project credits via service account, no API key):
# IMPRINT_VERTEX_PROJECT=imprint-hackathon-2026
# IMPRINT_VERTEX_LOCATION=global
IMPRINT_VERTEX_PROJECT=
IMPRINT_VERTEX_LOCATION=global
# Tier 2 (Gemma 4 active Mirror safety + text/image fallback) & Tier 3 (Free Gemini Flash-Lite):
GEMINI_API_KEY=
IMPRINT_GEMMA_ENABLED=true
# Tier 4 (Optional emergency fallback — leave blank on Cloud Run for 100% Google AI)
GROQ_API_KEY=

# Optional server-only overrides (copy only if set in Vercel; otherwise leave blank)
# Comma-separated role IDs from lib/assessment/catalog.ts, e.g. illustrator
IMPRINT_PILOT_ROLES=
# Comma-separated user UUIDs allowed to process score/provenance reviews
IMPRINT_REVIEWER_IDS=
# Optional pinned model versions (scoped separately to preserve score provenance)
IMPRINT_VERTEX_ASSESSMENT_MODEL=
IMPRINT_VERTEX_MIRROR_MODEL=
IMPRINT_VERTEX_TRANSCRIPTION_MODEL=
IMPRINT_GEMMA_MODEL=
IMPRINT_GEMMA_SAFETY_MODEL=
IMPRINT_GEMINI_ASSESSMENT_MODEL=
IMPRINT_GEMINI_MIRROR_MODEL=
IMPRINT_GEMINI_TRANSCRIPTION_MODEL=
IMPRINT_GROQ_ASSESSMENT_MODEL=
IMPRINT_GROQ_VISION_MODEL=
IMPRINT_GROQ_MIRROR_MODEL=
IMPRINT_GROQ_SAFETY_MODEL=
IMPRINT_GROQ_TRANSCRIPTION_MODEL=

# -----------------------------------------------------------------------------
# 3. OPTIONAL — Auth, Email Reminders & Visitor Beacon
# -----------------------------------------------------------------------------
# Enable if Google OAuth is configured in your Supabase project.
NEXT_PUBLIC_IMPRINT_GOOGLE_OAUTH_ENABLED=false

# Opted-in task reminder emails (copy only if you want reminder emails active)
RESEND_API_KEY=
IMPRINT_REMINDER_FROM=
IMPRINT_CRON_SECRET=

# Visitor beacon and crawler alerts -> Telegram (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 only if you want beacon/crawler alerts from localhost in dev
NEXT_PUBLIC_BEACON_DEBUG=
# Set to 1 to also send Telegram beacon alerts for bot visits
BEACON_ALERT_BOTS=

# -----------------------------------------------------------------------------
# 4. AUTO-CONFIGURED DURING CLOUD RUN DEPLOYMENT (leave blank / default here)
# -----------------------------------------------------------------------------
# Used for local dev; automatically overridden with your live Cloud Run URL on deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Automatically wired to your deployed `imprint-code-runner` Cloud Run service.
IMPRINT_RUNNER_ORIGIN=
IMPRINT_RUNNER_TOKEN=
# Optional: set to `gcp-oidc` if authenticating to the runner via GCP OIDC instead of token.
IMPRINT_RUNNER_AUTH=

# -----------------------------------------------------------------------------
# 5. LEAVE BLANK FOR HACKATHON DEPLOYMENT
# -----------------------------------------------------------------------------
# Keep unset so search engines don't index the hackathon copy as your main site.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
